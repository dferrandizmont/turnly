<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 widget (UW): four Monday-first weeks. Fixed layout: the next day off
     on top, seven weekday headers and four rows that the renderer fills with
     widget_four_weeks_cell (seven each) on every draw. The same layout shows
     the "open the app" message. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/four_weeks_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/widget_space_s"
        android:orientation="vertical">
        <TextView
            android:id="@+id/four_weeks_next_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingLeft="@dimen/widget_space_xxs"
            android:paddingBottom="@dimen/widget_space_xs"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_caption_size"
            android:textStyle="bold"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/four_weeks_weekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/fw_h0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
            <TextView
                android:id="@+id/fw_h1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
            <TextView
                android:id="@+id/fw_h2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
            <TextView
                android:id="@+id/fw_h3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
            <TextView
                android:id="@+id/fw_h4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
            <TextView
                android:id="@+id/fw_h5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
            <TextView
                android:id="@+id/fw_h6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="@dimen/widget_space_xxs"
                android:textColor="@color/widget_text_muted"
                android:textSize="@dimen/widget_caption_size"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/four_weeks_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/four_weeks_row0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"/>
            <LinearLayout
                android:id="@+id/four_weeks_row1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"/>
            <LinearLayout
                android:id="@+id/four_weeks_row2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"/>
            <LinearLayout
                android:id="@+id/four_weeks_row3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/stale"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/widget_space_l"
        android:visibility="gone">
        <TextView
            android:id="@+id/stale_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_stale_title_size"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/stale_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_xs"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_stale_body_size"/>
    </LinearLayout>
</FrameLayout>
