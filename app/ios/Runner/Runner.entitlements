<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Group shared with CuadranteWidget (widget snapshot) and time-sensitive
     notifications for the shift alarms. No iCloud keys: the iCloud replica is
     disabled by decision (docs/mac-ios.md 0.2, question 13). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.es.cuadrante.app</string>
	</array>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
