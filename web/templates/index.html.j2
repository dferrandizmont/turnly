{% extends 'base/layout.html.j2' %}
{% from 'base/screenshots.html.j2' import picture %}
{% from 'base/downloads.html.j2' import download %}
{% from 'base/faq.html.j2' import faq %}
{% from 'icons.html.j2' import icon %}
{% block content %}
{%- set light = shots[0] -%}
{%- set dark = shots[site.screenshots.index('01-mes-oscuro')] if '01-mes-oscuro' in site.screenshots else shots[0] -%}
{#- Feature icons follow the order of c.features: calendar, painting and rotations, alarms (bell), backups, hours (clock), shift
    swaps and holidays (flag). The colour class is a shift's (n Noche, m Mañana, t Tarde, s Saliente, g Guardia), only decorative. -#}
{%- set feature_icons = ['cal', 'brush', 'bell', 'backup', 'clock', 'swap', 'flag'] -%}
{%- set feature_bars = ['s-n', 's-m', 's-t', 's-s', 's-m', 's-n', 's-g'] -%}
{%- set key_bars = ['k-v', 'k-s', 'k-l'] -%}
<section id="about" class="hero" aria-labelledby="t-hero">
<div class="wrap">
<div class="hero-copy">
<h1 class="h1" id="t-hero"><span class="ln"><span>{{ c.hero_line_1 }}</span></span> <span class="ln"><span class="em">{{ c.hero_line_2 }}</span></span></h1>
<p class="chip"><i aria-hidden="true"></i>{{ c.chip }}</p>
<p class="lede">{{ c.intro }}</p>
<p class="cta"><a class="btn" href="#download">{{ icon('download') }}{{ c.hero_cta }}</a></p>
<ul class="keys">
{% for fact in c.key_facts.split(' · ') %}<li><i aria-hidden="true" class="kd {{ key_bars[loop.index0 % key_bars | length] }}"></i>{{ fact }}{% if not loop.last %}<span class="vh"> · </span>{% endif %}</li>
{% endfor %}</ul>
</div>
{#- Without JS (or if the demo cannot start) the first screenshot stands in for the demo, one picture per theme: CSS shows the one
    for the theme in use and the hidden one is lazy, so it is not downloaded. assets/site.js builds the board in #board and adds
    .demo-ready to <html>, which swaps one for the other. The demo texts travel in data-demo (JSON, never script). -#}
<figure class="hero-shot">
<span class="by-l">{{ picture(light, false, '(max-width: 960px) 280px, 360px') }}</span><span class="by-d">{{ picture(dark, false, '(max-width: 960px) 280px, 360px') }}</span>
</figure>
<div class="board app" id="board" hidden data-demo='{{ c.demo | tojson }}' role="group" aria-label="{{ c.demo.label }}"></div>
</div>
</section>

<section id="download" class="sec wrap" aria-labelledby="t-download">
<h2 id="t-download" class="h2 rv-me">{{ c.download_title }}</h2>
<p class="intro rv-me">{{ c.download_intro }}</p>
<div class="dl rv-me">
{#- A roster of rows: platform, store and its note on the left, the action (the common macro: the official badge with the state
    under it, or the dashed «coming soon» pill) on the right. The three closed-test steps follow the note when Google Play is in it. -#}
{% for item in site.downloads %}{% set steps = item.kind == 'play' and item.state == 'closed_test' %}<div class="dl-row">
<span class="dl-plat">{{ t.ios if item.kind in ('app_store', 'testflight') else t.android }}</span>
<div><h3>{{ t[item.kind] }}</h3>{% if c.download_notes[item.kind] %}<p>{{ c.download_notes[item.kind] }}</p>{% endif %}
{%- if steps %}
{% include 'base/closed_test.html.j2' %}
{%- endif %}</div>
<div class="dl-act">{{ download(item, t, lang) }}</div>
</div>
{% endfor %}</div>
</section>

<section id="screenshots" class="sec wrap" aria-labelledby="t-shots">
<h2 id="t-shots" class="h2 rv-me">{{ c.screenshots_title }}</h2>
<p class="intro rv-me">{{ c.screenshots_intro }}</p>
{#- One screen at a time: tabs, the capture and what it shows. `site.screenshots` lists each light capture followed by its dark twin
    (NN-name, NN-name-oscuro): both go in the same slide, CSS shows the one for the theme in use and the hidden one is lazy, so it
    is not fetched. Without JS every slide is listed (two per row); assets/site.js adds the tabs and the previous / next buttons and
    shows one slide at a time. Under each capture the common «enlarge» link opens the 720 px version. -#}
{%- set tour_sizes = '(max-width: 900px) 280px, 300px' -%}
<div class="tour rv-me" id="tour" data-label="{{ c.screenshots_nav }}" data-prev="{{ c.screenshots_prev }}" data-next="{{ c.screenshots_next }}" data-position="{{ c.screenshots_position }}" data-count="{{ c.screenshots_count }}">
<ol class="slides">
{% for shot in shots %}{% if not site.screenshots[loop.index0].endswith('-oscuro') %}{% set name = site.screenshots[loop.index0] %}<li class="slide">
<div class="phone"><span class="by-l">{{ picture(shot, loop.first, tour_sizes, true, t) }}</span><span class="by-d">{{ picture(shots[loop.index0 + 1], false, tour_sizes, true, t) }}</span></div>
<div class="shot-txt"><h3>{{ c.screenshot_captions[name] }}</h3><p>{{ c.screenshot_details[name] }}</p></div>
</li>
{% endif %}{% endfor %}</ol>
<p class="vh" id="shotLive" role="status" aria-live="polite"></p>
</div>
</section>

<section id="features" class="sec wrap" aria-labelledby="t-feat">
<div class="feat">
<div class="feat-head rv-me">
<h2 id="t-feat" class="h2">{{ c.features_title }}</h2>
<p class="intro">{{ c.features_intro }}</p>
</div>
<ol class="flist">
{% for feature in c.features %}{% set k = loop.index0 % feature_icons | length %}<li class="{{ feature_bars[k] }} rv-me"><span class="fic">{{ icon(feature_icons[k]) }}</span><div><h3>{{ c.feature_titles[loop.index0] }}</h3><p>{{ feature }}</p></div></li>
{% endfor %}</ol>
</div>
</section>

<section id="privacy" class="band" aria-labelledby="t-priv">
<div class="wrap band-in">
<div class="rv-me">
<h2 id="t-priv" class="h2">{{ c.privacy_title }}</h2>
</div>
<div class="rv-me">
{% for sentence in c.privacy_summary %}<p>{{ sentence }}</p>
{% endfor %}<a class="link-btn" href="{{ route(lang, true) }}">{{ t.privacy_full }}{{ icon('arrow') }}</a>
</div>
</div>
</section>

<section id="support" class="sec wrap" aria-labelledby="t-sup">
<div class="help">
<div class="rv-me">
<h2 id="t-sup" class="h2">{{ t.faq }}</h2>
<p class="intro">{{ c.support_intro }}</p>
<a class="mail" href="mailto:{{ contact_email }}">{{ icon('mail') }}<span>{{ contact_email }}</span></a>
</div>
<div class="qa rv-me">{{ faq(c.faq) }}</div>
</div>
</section>
{% endblock %}
