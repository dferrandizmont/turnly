{%- elif name == 'plus' %}<path d="M12 5v14M5 12h14"></path>
{%- elif name == 'left' %}<path d="M15 5l-7 7 7 7"></path>
{%- elif name == 'right' %}<path d="M9 5l7 7-7 7"></path>
{%- endif %}</svg>
{%- endmacro %}

